# Docker
docker-compose.override.yml

# Node / Tailwind
node_modules/
app/static/css/tailwind.css

# package-lock.json is intentionally NOT ignored: the Dockerfile runs `npm ci`,
# which requires it, and committing it is what pins the transitive tree.

# Design handoff material — the source-of-truth mockups for the 3.x overhaul.
# Useful to keep locally, but it is 340K of static reference with no runtime
# role, so it stays out of the application repo.
design_handoff_coverbound_overhaul/

# Dev harness output (scripts/shots.js, check_all.js --shots, Playwright)
coverbound-shots/
shots/
test-results/
playwright-report/
.playwright/

