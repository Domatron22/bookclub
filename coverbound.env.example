# Copy this file to `coverbound.env` and fill it in — `make init` does both,
# and generates the SECRET_KEY for you. The real coverbound.env is gitignored:
# it holds this deployment's signing key and must never be committed.

# Database Configuration
DATABASE_URL=sqlite:///./data/coverbound.db
# For PostgreSQL, use: postgresql://user:password@localhost/coverbound

# Application Security
# Generated per deployment by `make init`. Session cookies carry the logged-in
# user's identity, so a shared or published key lets anyone forge a login.
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Debug Mode. Leave false anywhere reachable from a network: DEBUG=true drops
# the Secure flag from session cookies and allows an unset SECRET_KEY.
DEBUG=false

# GitHub issue mirroring for in-app feedback (optional).
# Without a token, feedback is still stored — it just isn't filed as an issue.
# Needs `issues: write` on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=Domatron22/bookclub

# Google sign-in (optional).
# Leave blank to disable — the Google buttons disappear and username +
# account-secret login works exactly as before.
#
# Create credentials at https://console.cloud.google.com/apis/credentials:
#   1. Configure the OAuth consent screen (External; scopes: openid, email, profile)
#   2. Create an OAuth client ID of type "Web application"
#   3. Add an Authorised redirect URI ending in /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address users type, used to build the OAuth redirect URI.
# Required behind a reverse proxy: the app otherwise sees plain HTTP on an
# internal host and would send Google a redirect URI it rejects.
# e.g. https://coverbound.club   (dev: http://localhost:8000)
PUBLIC_BASE_URL=

# Where this deployment's source code lives, linked from the page footer.
# The GPL gives everyone the right to the source of the code they are running,
# so if you run a modified Coverbound, point this at your own repository.
SOURCE_URL=
